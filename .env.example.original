# Optional: enables saved trips. Create a free PostgreSQL database with Supabase.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Supabase session-pooler URL (port 5432). Prisma uses this one for database schema changes and queries.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Required for sign-in and account-linked saved trips. Find both values in Supabase → Connect → Framework.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"

# Optional: enables personalised AI-generated itineraries using the Gemini API free tier.
# Create a key at https://aistudio.google.com/apikey. Without it, the app returns a polished demo itinerary.
GEMINI_API_KEY=""
# Optional: defaults to Gemini 3.5 Flash.
# GEMINI_MODEL="gemini-3.5-flash"
